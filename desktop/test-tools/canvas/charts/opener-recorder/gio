#!/usr/bin/env python3
"""Harmless native-opener recorder. Never invokes another process or browser."""
import json
import os
from pathlib import Path
import sys
import time
from urllib.parse import parse_qs, urlsplit

CASES = {'unnamed', 'named', 'unnamed-retry', 'preview-popup', 'external-normal'}
rows = []
for raw in sys.argv[1:]:
    if not raw.startswith(('https://', 'http://')):
        continue
    url = urlsplit(raw)
    own_path = url.path in ('/cdn-cgi/preview-platform/vibez-synthetic-routing-probe', '/vibez-synthetic-routing-probe')
    tag = parse_qs(url.query).get('vibez_case', [None])[0] if own_path else None
    rows.append({'wallTimeNs': time.time_ns(), 'opener': Path(sys.argv[0]).name,
                 'origin': f'{url.scheme}://{url.hostname}' + (f':{url.port}' if url.port else ''),
                 'fixtureCase': tag if tag in CASES else None,
                 'canvasPreviewTarget': url.hostname == 'canvas.mistralusercontent.com' and own_path,
                 'pathAndQueryStored': False, 'browserStarted': False})
if not rows:
    rows = [{'wallTimeNs': time.time_ns(), 'opener': Path(sys.argv[0]).name, 'httpUrls': 0, 'browserStarted': False}]
with open(os.environ['VIBEZ_CANVAS_OPEN_LOG'], 'a') as output:
    for row in rows:
        output.write(json.dumps(row) + '\n')
